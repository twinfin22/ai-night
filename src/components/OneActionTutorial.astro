---
import { courseVersion, type OneActionTutorialDay } from '../data/course';
const { item } = Astro.props as { item: OneActionTutorialDay };
const clientPages = item.pages.map(({ source: _source, authorNote: _authorNote, ...page }) => page);
---

<main class="one-action" data-one-action data-day={item.day} data-day-title={item.title} data-outcome={item.outcome} data-course-version={courseVersion} data-pages={JSON.stringify(clientPages)} data-storage={JSON.stringify({ version: 'ainight.version', done: 'ainight.done', position: 'ainight.position', last: 'ainight.last', app: 'ainight.app', os: 'ainight.os', draft: 'ainight.draft' })}>
  <section class="one-action__preflight" data-preflight hidden aria-labelledby="app-choice-title">
    <p class="eyebrow">수업 시작 전</p>
    <h1 id="app-choice-title">당신의 에이전트를<br />골라주세요</h1>
    <p class="one-action__preflight-intro">에이전트와 컴퓨터를 모두 고르면, 그 환경에 맞는 수업을 보여드려요.</p>
    <fieldset class="one-action__app-options"><legend>나와 함께할 에이전트</legend>
      <label class="one-action__agent-card one-action__agent-card--codex"><input type="radio" name="app" value="codex" /><span class="one-action__agent-logo"><img src="/assets/tutorials/brands/openai.svg" alt="" width="38" height="38" /></span><span class="one-action__agent-copy"><small>OPENAI</small><strong>Codex</strong><span>작업 폴더 안의 파일을 직접 만들고 고쳐요.</span></span><span class="one-action__agent-select" aria-hidden="true"></span></label>
      <label class="one-action__agent-card one-action__agent-card--claude"><input type="radio" name="app" value="claude" /><span class="one-action__agent-logo"><img src="/assets/tutorials/brands/anthropic.svg" alt="" width="38" height="38" /></span><span class="one-action__agent-copy"><small>ANTHROPIC</small><strong>Claude</strong><span>대화와 자료를 바탕으로 생각을 정리해요.</span></span><span class="one-action__agent-select" aria-hidden="true"></span></label>
    </fieldset>
    <fieldset class="one-action__app-options"><legend>사용 중인 컴퓨터</legend>
      <label class="one-action__agent-card"><input type="radio" name="os" value="macos" /><span class="one-action__agent-copy"><strong>macOS</strong><span>Mac에서 수업을 따라갑니다.</span></span></label>
      <label class="one-action__agent-card"><input type="radio" name="os" value="windows" /><span class="one-action__agent-copy"><strong>Windows</strong><span>Windows에서 수업을 따라갑니다.</span></span></label>
    </fieldset><button class="one-action__primary" type="button" data-start disabled>수업 시작</button>
  </section>
  <section class="one-action__shell" data-lesson hidden aria-label={`${item.day}일차 수업`}>
    <aside class="one-action__coach" data-coach>
      <header class="one-action__header"><a href="/tutorials/" class="one-action__brand" aria-label="AI 야학 수업 목록">AI 야학</a><strong title={`${item.day}일차 · ${item.title}`}><span>{item.day}일차</span> · {item.title}<small data-time>{item.time}</small></strong><button type="button" class="one-action__environment" data-environment-edit>환경 변경</button><div class="one-action__progress" role="progressbar" aria-label="현재 수업 단계" aria-valuemin="1" data-progress><span data-progress-label>1 / {item.pages.length}</span></div></header>
      <div class="one-action__guide" data-guide><p class="one-action__eyebrow">지금 할 일</p><h1 tabindex="-1" data-title></h1><p data-description></p><strong data-action></strong><div data-guide-content></div><p class="one-action__persistence-warning" data-persistence-warning hidden role="status">저장소에 접근하지 못했습니다. 수업은 계속할 수 있지만 재접속하면 진도가 유지되지 않을 수 있습니다.</p><p class="one-action__status" data-status role="status" aria-live="polite"></p></div>
    </aside>
    <section class="one-action__visual" data-visual aria-label="참고 화면"></section>
    <div class="one-action__support" data-support><div data-support-details></div><footer class="one-action__actions"><button type="button" data-prev>이전</button><button type="button" class="one-action__help" data-help>도움이 필요해요</button><button type="button" data-next>다음</button></footer></div>
  </section>
  <dialog class="tutorial-help-dialog" data-help-dialog aria-labelledby="tutorial-help-title">
    <form method="dialog" class="tutorial-help-dialog__panel" data-help-form novalidate>
      <div class="tutorial-help-dialog__head"><div><p class="one-action__eyebrow">AI 야학 문의</p><h2 id="tutorial-help-title">도움을 요청할게요</h2></div><button type="button" class="tutorial-help-dialog__close" data-help-close aria-label="문의 창 닫기">×</button></div>
      <p class="tutorial-help-dialog__intro" data-help-intro>답변받을 이메일과 지금 막힌 내용을 적어 주세요.</p>
      <dl class="tutorial-help-dialog__context" data-help-context aria-label="함께 전송되는 수업 정보"></dl>
      <label class="tutorial-help-dialog__field"><span>답변받을 이메일</span><input type="email" name="email" autocomplete="email" required data-help-email /></label>
      <label class="tutorial-help-dialog__field"><span>질문</span><textarea name="question" rows="6" maxlength="2000" required data-help-question aria-describedby="help-question-count"></textarea><small id="help-question-count" data-help-question-count aria-live="polite">0 / 2,000자</small></label>
      <p class="tutorial-help-dialog__error" data-help-error hidden role="alert"></p>
      <p class="tutorial-help-dialog__success" data-help-success hidden role="status">문의가 접수되었습니다. 입력한 이메일로 답변드립니다.</p>
      <div class="tutorial-help-dialog__actions"><button type="button" data-help-cancel>취소</button><button type="submit" data-help-submit>보내기</button></div>
    </form>
  </dialog>
  <dialog class="tutorial-image-dialog" data-image-dialog aria-labelledby="tutorial-image-title">
    <div class="tutorial-image-dialog__panel">
      <div class="tutorial-image-dialog__head">
        <h2 id="tutorial-image-title">참고 화면 크게 보기</h2>
        <button type="button" class="tutorial-image-dialog__close" data-image-close aria-label="참고 화면 닫기">×</button>
      </div>
      <p id="tutorial-image-description" class="tutorial-image-dialog__description" data-image-description></p>
      <img data-image-original alt="" aria-describedby="tutorial-image-description" />
    </div>
  </dialog>
</main>

<script>
  // @ts-nocheck
  import { markTutorialComplete, persistenceFailureMessage, readTutorialPosition, runCourseMigrations, saveTutorialPosition } from '../lib/tutorial-progress';
  const root = document.querySelector('[data-one-action]');
  const pages = JSON.parse(root?.getAttribute('data-pages') || '[]');
  const day = Number(root?.getAttribute('data-day') || '0');
  const dayTitle = root?.getAttribute('data-day-title') || '';
  const lessonOutcome = root?.getAttribute('data-outcome') || '';
  const courseVersion = root?.getAttribute('data-course-version') || '미선택';
  const keys = JSON.parse(root?.getAttribute('data-storage') || '{}');
  const read = (storage, key, fallback) => { try { return JSON.parse(storage.getItem(key) || '') || fallback; } catch { return fallback; } };
  let persistenceFailed = false;
  const storageWarning = root.querySelector('[data-persistence-warning]');
  const noteStorageFailure = () => { persistenceFailed = true; if (storageWarning) { storageWarning.textContent = persistenceFailureMessage; storageWarning.hidden = false; } };
  const write = (storage, key, value) => { try { storage.setItem(key, JSON.stringify(value)); return true; } catch { noteStorageFailure(); return false; } };
  try { if (!runCourseMigrations(localStorage)) noteStorageFailure(); } catch { noteStorageFailure(); }
  const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (ch) => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' })[ch]);
  const preflight = root.querySelector('[data-preflight]'), lesson = root.querySelector('[data-lesson]');
  const start = root.querySelector('[data-start]'), appInput = root.querySelectorAll('input[name="app"]'), osInput = root.querySelectorAll('input[name="os"]');
  const savedApp = (() => { try { return localStorage.getItem(keys.app); } catch { return null; } })();
  let app = savedApp === 'codex' || savedApp === 'claude' ? savedApp : null;
  let os = (() => { try { return localStorage.getItem(keys.os); } catch { return null; } })();
  if (os !== 'macos' && os !== 'windows') os = null;
  appInput.forEach((input) => { input.checked = input.value === app; });
  osInput.forEach((input) => { input.checked = input.value === os; });
  let visible = [], index = 0, memoryDraft = {}, pendingStepId = null, editingEnvironment = false;
  const pageKey = () => visible[index]?.id;
  const drafts = () => ({ ...read(localStorage, keys.draft, {}), ...read(sessionStorage, keys.draft, {}), ...memoryDraft });
  const values = () => drafts()[pageKey()] || {};
  const saveValue = (control, value) => { const target = control.persist === 'session' ? sessionStorage : localStorage; const all = read(target, keys.draft, {}); all[pageKey()] = { ...(all[pageKey()] || {}), [control.id]: value }; if (!write(target, keys.draft, all)) memoryDraft = { ...memoryDraft, [pageKey()]: { ...(memoryDraft[pageKey()] || {}), [control.id]: value } }; };
  const choiceValue = (choiceKey) => {
    const owners = pages.filter((page) => page.controls?.some((control) => control.id === choiceKey));
    if (owners.length !== 1) return undefined;
    return drafts()[owners[0].id]?.[choiceKey];
  };
  const getVisible = () => pages
    .filter((page) => !page.track || page.track === app)
    .filter((page) => !page.platform || page.platform === os)
    .filter((page) => !page.visibleWhen || choiceValue(page.visibleWhen.choiceKey) === page.visibleWhen.equals);
  const positionApp = () => app || 'common';
  const hasAppTracks = pages.some((page) => page.track);
  const updateStart = () => { if (start) start.disabled = !(app && os); };
  const selectedCount = (value) => Array.isArray(value) ? value.length : value ? 1 : 0;
  const controlsComplete = (page) => (page.controls || []).every((control) => { const count = selectedCount(values()[control.id]); return !(control.required && !count) && !(control.exact !== undefined && count !== control.exact) && !(control.min !== undefined && count < control.min) && !(control.max !== undefined && count > control.max); });
  const highlighted = (text, tokens = []) => tokens.reduce((html, token) => html.replaceAll(esc(token), `<mark>${esc(token)}</mark>`), esc(text));
  const controlHtml = (control, current) => {
    const name = `control-${esc(control.id)}`;
    if (control.type === 'text') return `<label class="guide-field"><span>${esc(control.label)}</span><textarea data-control="${esc(control.id)}" rows="3">${esc(current || '')}</textarea></label>`;
    const type = control.type === 'radio' ? 'radio' : 'checkbox'; const selected = Array.isArray(current) ? current : [current];
    return `<fieldset class="guide-choice"><legend>${esc(control.label)}</legend>${(control.options || []).map((option) => `<label><input data-control="${esc(control.id)}" type="${type}" name="${name}" value="${esc(option.value)}" ${selected.includes(option.value) ? 'checked' : ''}><strong>${esc(option.label)}</strong>${option.description ? `<span>${esc(option.description)}</span>` : ''}</label>`).join('')}</fieldset>`;
  };
  const promptVisual = (page) => page.prompt ? `<div class="visual-prompt"><pre><code>${highlighted(page.prompt, page.highlightTokens)}</code></pre></div>` : '';
  const imagesVisual = (images) => images?.length ? `<div class="visual-images">${images.map((image, imageIndex) => `<figure class="visual-image"><button type="button" data-image-open data-image-src="${esc(image.src)}" data-image-alt="${esc(image.alt)}" aria-label="참고 화면 ${imageIndex + 1} 크게 보기: ${esc(image.alt)}"><img src="${esc(image.src)}" alt="${esc(image.alt)}"><span class="visual-image__zoom" aria-hidden="true">원본 크게 보기 ↗</span></button></figure>`).join('')}</div>` : '';
  const guideLinks = (page) => `${page.prompt ? '<div class="guide-copy"><button type="button" class="one-action__primary" data-copy aria-describedby="copy-feedback">프롬프트 복사하기</button><p id="copy-feedback" class="guide-copy__feedback" data-copy-feedback role="status" aria-live="polite" hidden></p></div>' : ''}${page.officialLinks?.length ? `<div class="guide-links" aria-label="공식 링크">${page.officialLinks.map((link) => `<a href="${esc(link.href)}" target="_blank" rel="noopener noreferrer"><strong>${esc(link.label)} <span aria-label="새 창">↗</span></strong><span>${esc(link.publisher)} · ${esc(link.verifiedAt)} 확인</span><small>${esc(link.accessNote)}</small></a>`).join('')}</div>` : ''}${page.downloadLinks?.length ? `<div class="guide-downloads" aria-label="자료 다운로드">${page.downloadLinks.map((link) => `<a href="${esc(link.href)}" download>${esc(link.label)} 다운로드</a>`).join('')}</div>` : ''}`;
  const visualHtml = (page) => {
    if (page.view === 'FOCUS') return page.subtitle || page.flow?.length || page.outcome ? `<div class="visual-focus">${page.subtitle ? `<p>${esc(page.subtitle)}</p>` : ''}${page.flow?.length ? `<ol class="visual-timeline" data-timeline>${page.flow.map((part) => `<li><span aria-hidden="true"></span>${esc(part)}</li>`).join('')}</ol>` : ''}${page.outcome ? `<strong>결과물: ${esc(page.outcome)}</strong>` : ''}</div>` : '';
    if (page.view === 'COMPARISON') return page.comparison?.length ? `<div class="visual-comparison">${page.comparison.map((part) => `<section><strong>${esc(part.label)}</strong><p>${esc(part.content)}</p></section>`).join('')}</div>` : '';
    return `${imagesVisual(page.images || (page.image ? [page.image] : []))}${promptVisual(page)}`;
  };
  const supportHtml = (page) => page.technicalDetails?.length ? `<details class="guide-details"><summary>안 보여요 · 보충 설명</summary>${page.technicalDetails.map((detail) => `<section><strong>${esc(detail.title)}</strong><p>${esc(detail.body)}</p></section>`).join('')}</details>` : '';
  const report = (message, alert = false) => { const status = root.querySelector('[data-status]'); status.textContent = message; status.setAttribute('role', alert ? 'alert' : 'status'); };
  const helpDialog = root.querySelector('[data-help-dialog]');
  const helpForm = root.querySelector('[data-help-form]');
  const helpEmail = root.querySelector('[data-help-email]');
  const helpQuestion = root.querySelector('[data-help-question]');
  const helpContext = root.querySelector('[data-help-context]');
  const helpError = root.querySelector('[data-help-error]');
  const helpSuccess = root.querySelector('[data-help-success]');
  const helpSubmit = root.querySelector('[data-help-submit]');
  const imageDialog = root.querySelector('[data-image-dialog]');
  const imageOriginal = root.querySelector('[data-image-original]');
  const imageDescription = root.querySelector('[data-image-description]');
  let imageReturnFocus = null;
  let helpReturnFocus = null, inquiryContext = null, inquiryRequestId = null;
  const selectedBranch = () => {
    const condition = pages.find((page) => page.visibleWhen)?.visibleWhen;
    return condition ? choiceValue(condition.choiceKey) || '미선택' : '해당 없음';
  };
  const helpContextEntries = (context) => [
    ['수업', `Day ${context.day} · ${context.dayTitle}`],
    ['단계', `${context.stepId} · ${context.stepTitle}`],
    ['앱', context.app || '미선택'],
    ['운영체제', context.os || '미선택'],
    ['실습 분기', context.branch],
    ['교재 버전', context.version],
  ];
  const renderHelpContext = (context) => { if (helpContext) helpContext.innerHTML = helpContextEntries(context).map(([label, value]) => `<div><dt>${esc(label)}</dt><dd>${esc(value)}</dd></div>`).join(''); };
  const resetHelpResult = () => { helpError.hidden = true; helpError.textContent = ''; helpSuccess.hidden = true; helpSubmit.disabled = false; helpSubmit.textContent = '보내기'; };
  const closeHelp = () => { if (helpDialog?.open) helpDialog.close(); };
  const openHelp = (trigger) => {
    const page = visible[index];
    if (!page || !helpDialog) return;
    helpReturnFocus = trigger;
    inquiryRequestId = null;
    inquiryContext = { day, dayTitle, stepId: page.id, stepTitle: page.title, app: app || null, os: os || null, branch: selectedBranch(), version: courseVersion };
    renderHelpContext(inquiryContext);
    resetHelpResult();
    helpDialog.showModal();
    requestAnimationFrame(() => helpEmail?.focus());
  };
  root.querySelector('[data-help]')?.addEventListener('click', (event) => openHelp(event.currentTarget));
  root.querySelector('[data-help-close]')?.addEventListener('click', closeHelp);
  root.querySelector('[data-help-cancel]')?.addEventListener('click', closeHelp);
  helpDialog?.addEventListener('close', () => { helpReturnFocus?.focus(); helpReturnFocus = null; });
  const closeImage = () => { if (imageDialog?.open) imageDialog.close(); };
  root.querySelector('[data-image-close]')?.addEventListener('click', closeImage);
  imageDialog?.addEventListener('close', () => { imageReturnFocus?.focus(); imageReturnFocus = null; });
  const openImage = (trigger) => {
    if (!imageDialog || !imageOriginal || !imageDescription) return;
    imageReturnFocus = trigger;
    imageOriginal.src = trigger.dataset.imageSrc || '';
    imageOriginal.alt = trigger.dataset.imageAlt || '참고 화면';
    imageDescription.textContent = trigger.dataset.imageAlt || '참고 화면 원본입니다.';
    imageDialog.showModal();
    requestAnimationFrame(() => root.querySelector('[data-image-close]')?.focus());
  };
  helpQuestion?.addEventListener('input', () => { const count = root.querySelector('[data-help-question-count]'); if (count) { const length = helpQuestion.value.length; count.textContent = length >= 2000 ? '2,000 / 2,000자 · 최대 글자 수입니다.' : `${length.toLocaleString('ko-KR')} / 2,000자`; } });
  helpForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!inquiryContext || !helpEmail?.value.trim() || !helpQuestion?.value.trim()) { helpError.textContent = '이메일과 질문을 모두 입력해 주세요.'; helpError.hidden = false; return; }
    if (!helpEmail.validity.valid) { helpError.textContent = '답변받을 이메일 형식을 확인해 주세요.'; helpError.hidden = false; helpEmail.focus(); return; }
    if (helpQuestion.value.length > 2000) { helpError.textContent = '질문은 2,000자 이내로 입력해 주세요.'; helpError.hidden = false; helpQuestion.focus(); return; }
    if (!inquiryRequestId) inquiryRequestId = crypto.randomUUID?.() || `${Date.now()}-${Math.random()}`;
    helpError.hidden = true;
    helpSubmit.disabled = true;
    helpSubmit.textContent = '보내는 중';
    try {
      const result = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: 'tutorial', email: helpEmail.value.trim(), question: helpQuestion.value.trim(), requestId: inquiryRequestId, context: inquiryContext }) });
      const payload = await result.json().catch(() => ({}));
      if (!result.ok || !payload.ok) throw new Error(payload.error || '문의 접수에 실패했습니다.');
      helpSuccess.hidden = false;
      helpSubmit.disabled = true;
      helpSubmit.textContent = '접수됨';
      helpQuestion.value = '';
      inquiryRequestId = null;
    } catch (error) {
      helpError.textContent = error instanceof Error ? error.message : '문의 접수에 실패했습니다. 잠시 후 다시 시도해 주세요.';
      helpError.hidden = false;
      helpSubmit.disabled = false;
      helpSubmit.textContent = '다시 보내기';
    }
  });
  const updateNext = (page = visible[index]) => { root.querySelector('[data-next]').disabled = !controlsComplete(page); };
  const renderContent = (page) => {
    const guide = root.querySelector('[data-guide-content]'), visual = root.querySelector('[data-visual]'), support = root.querySelector('[data-support-details]'), state = values();
    const controls = (page.controls || []).map((control) => controlHtml(control, state[control.id])).join('');
    const supporting = page.supporting && page.supporting !== page.description && page.supporting !== page.action ? `<p class="guide-supporting">${esc(page.supporting)}</p>` : '';
    const completion = index === visible.length - 1 ? `<section class="lesson-completion" aria-labelledby="completion-title"><p class="one-action__eyebrow">수업 마무리</p><h2 id="completion-title">결과를 직접 확인해요</h2><ul><li>${esc(lessonOutcome)}</li><li>AI 앱에서 오늘 결과를 직접 확인했습니다.</li><li>다음에 다시 찾을 위치를 알고 있습니다.</li></ul><p>아래 버튼을 누르면 내 확인에 따라 이 수업을 완료로 기록합니다.</p></section>` : '';
    guide.innerHTML = `${page.view === 'WORKBOOK' ? '<p class="guide-note">이 회고는 AI가 대신 쓰거나 평가하지 않습니다. 내 말로 작성하세요.</p>' : ''}${supporting}${controls}${completion}`;
    const visualContent = visualHtml(page);
    visual.dataset.view = page.view;
    visual.hidden = !visualContent;
    visual.innerHTML = visualContent;
    support.innerHTML = `${guideLinks(page)}${supportHtml(page)}`;
    guide.querySelectorAll('[data-control]').forEach((input) => input.addEventListener('input', () => { const control = page.controls.find((item) => item.id === input.dataset.control); const value = control.type === 'checkbox' ? [...guide.querySelectorAll(`[data-control="${CSS.escape(control.id)}"]:checked`)].map((item) => item.value) : input.value; saveValue(control, value); if (page.kind === 'CHOICE') { const currentId = page.id; visible = getVisible(); index = Math.max(0, visible.findIndex((item) => item.id === currentId)); render(); return; } updateNext(page); }));
    support.querySelector('[data-copy]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const feedback = support.querySelector('[data-copy-feedback]'); try { await navigator.clipboard.writeText(page.prompt || ''); button.textContent = '프롬프트 복사됨'; feedback.textContent = '복사했습니다. AI 앱에 붙여 넣어 실행해 보세요.'; feedback.hidden = false; feedback.dataset.state = 'success'; report('프롬프트를 복사했습니다.'); } catch { button.textContent = '다시 복사하기'; feedback.textContent = '복사하지 못했습니다. 프롬프트를 직접 선택해 복사해 주세요.'; feedback.hidden = false; feedback.dataset.state = 'error'; report('복사하지 못했습니다. 직접 선택해 복사해 주세요.', true); } });
    visual.querySelectorAll('[data-image-open]').forEach((trigger) => trigger.addEventListener('click', () => openImage(trigger)));
    visual.querySelectorAll('img').forEach((image) => image.addEventListener('error', () => { image.closest('figure')?.remove(); if (!visual.querySelector('.visual-image, .visual-prompt, .visual-focus, .visual-comparison')) visual.hidden = true; report('스크린샷을 불러오지 못했습니다.', true); }));
  };
  const render = (focus = false) => { const page = visible[index]; if (!page) { root.querySelector('[data-guide-content]').innerHTML = '<div class="guide-recovery"><h2>열 수 있는 수업 화면이 없습니다.</h2><a href="/tutorials/">수업 목록으로</a></div>'; root.querySelector('[data-visual]').innerHTML = ''; report('수업 화면을 복구하지 못했습니다.', true); return; } root.querySelector('[data-title]').textContent = page.title; root.querySelector('[data-description]').textContent = page.description; root.querySelector('[data-action]').textContent = page.action || ''; root.querySelector('[data-progress-label]').textContent = `${index + 1} / ${visible.length}`; const progress = root.querySelector('[data-progress]'); progress.setAttribute('aria-valuemax', String(visible.length)); progress.setAttribute('aria-valuenow', String(index + 1)); root.querySelector('[data-prev]').disabled = index === 0; root.querySelector('[data-next]').textContent = index === visible.length - 1 ? '결과를 확인하고 수업 완료' : '다음'; renderContent(page); updateNext(page); if (!saveTutorialPosition(localStorage, { day, app: positionApp(), stepId: page.id })) noteStorageFailure(); if (focus) root.querySelector('[data-title]').focus(); };
  const begin = () => { if (hasAppTracks && (!app || !os)) return; try { if (app) localStorage.setItem(keys.app, app); if (os === 'macos' || os === 'windows') localStorage.setItem(keys.os, os); if (!runCourseMigrations(localStorage)) noteStorageFailure(); } catch { noteStorageFailure(); } visible = getVisible(); const saved = readTutorialPosition(localStorage, day, positionApp()); const stableIndex = pendingStepId ? visible.findIndex((page) => page.id === pendingStepId) : -1; const savedIndex = visible.findIndex((page) => page.id === saved); index = stableIndex >= 0 ? stableIndex : Math.max(0, savedIndex); const recovered = editingEnvironment && pendingStepId && stableIndex < 0; pendingStepId = null; editingEnvironment = false; preflight.hidden = true; lesson.hidden = false; render(); if (recovered) report('새 환경에서 같은 단계를 열 수 없어, 이 수업의 안전한 시작 단계로 이동했습니다.'); };
  appInput.forEach((input) => input.addEventListener('change', () => { app = input.value; updateStart(); })); osInput.forEach((input) => input.addEventListener('change', () => { os = input.value; updateStart(); })); start?.addEventListener('click', begin);
  root.querySelector('[data-environment-edit]')?.addEventListener('click', () => { pendingStepId = pageKey(); editingEnvironment = true; start.textContent = '변경 저장'; preflight.hidden = false; lesson.hidden = true; });
